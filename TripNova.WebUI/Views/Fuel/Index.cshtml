    margin:auto;
    background:#171717;
    border-radius:25px;
    padding:40px;
    color:white;">

        <h2 class="fw-bold mb-4">
            ⛽ Akaryakıt Fiyatları
        </h2>

        <div class="d-flex justify-content-between mb-3">

            <span>Benzin</span>

            <strong style="color:#C8A45D;">
