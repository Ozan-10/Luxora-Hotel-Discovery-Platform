<div class="container mt-5">

    <div style="
    max-width:500px;
    margin:auto;
    background:#171717;
    border-radius:25px;
    padding:40px;
    color:white;">

        <h2 class="fw-bold mb-4">
            💵 Canlı Döviz
        </h2>

        <div class="d-flex justify-content-between mb-3">
            <span>USD → TRY</span>
            <strong style="color:#C8A45D;">
                @ViewBag.tryRate
            </strong>
        </div>

        <div class="d-flex justify-content-between mb-3">
            <span>USD → EUR</span>
            <strong style="color:#C8A45D;">
                @ViewBag.eurRate
            </strong>
        </div>

        <div class="d-flex justify-content-between">
            <span>USD → GBP</span>
            <strong style="color:#C8A45D;">
                @ViewBag.gbpRate
            </strong>
        </div>

    </div>

</div>