@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        Luxora Dashboard
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>


            * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient( rgba(3,7,18,.82), rgba(0,0,0,.92) ), url('https://images.unsplash.com/photo-1582719508461-905c673771fd?q=80&w=2070');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            color: white;
            font-family: 'Segoe UI',sans-serif;
        }

        .navbar-lux {
            width: 100%;
            padding: 22px 70px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0,0,0,.55);
            border-bottom: 1px solid rgba(200,164,93,.12);
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 38px;
            font-weight: 800;
            color: #C8A45D;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .hero {
            text-align: center;
            padding-top: 70px;
        }

        .mini-title {
            color: #C8A45D;
            letter-spacing: 4px;
            font-size: 15px;
            margin-bottom: 10px;
        }

        .main-title {
            font-size: 90px;
            font-weight: 900;
            line-height: 1;
        }

        .gold-text {
            color: #C8A45D;
        }

        .hero-desc {
            margin-top: 25px;
            color: #d4d4d4;
            font-size: 22px;
        }

        .dashboard-wrapper {
            width: 92%;
            margin: auto;
            margin-top: 70px;
        }

        .tools-wrapper {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 30px;
            align-items: start;
            margin-top: 40px;
        }

        @@media(max - width:992px) {
            .tools-wrapper

        {
            grid-template-columns: 1fr;
        }

        }

        .lux-weather-card {
            width: 340px;
            background: rgba(12,12,12,.88);
            border: 1px solid rgba(200,164,93,.25);
            border-radius: 30px;
            padding: 30px;
            backdrop-filter: blur(18px);
            box-shadow: 0 0 45px rgba(0,0,0,.45);
        }

        .weather-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .weather-mini-title {
            color: #C8A45D;
            font-size: 12px;
            letter-spacing: 2px;
        }

        .weather-top h2 {
            color: #fff;
            margin-top: 8px;
            font-weight: 700;
        }

        .weather-search {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #C8A45D;
        }

        .weather-center {
            text-align: center;
            margin-top: 35px;
        }

        .weather-main-icon {
            font-size: 70px;
            color: #d7c0ff;
            margin-bottom: 20px;
        }

        .weather-center h1 {
            color: #fff;
            font-size: 70px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .weather-center p {
            color: #9d9d9d;
            font-size: 18px;
        }

        .weather-days {
            display: flex;
            justify-content: space-between;
            margin-top: 35px;
            gap: 10px;
        }

        .weather-day {
            flex: 1;
            background: #171717;
            border-radius: 18px;
            padding: 18px 10px;
            text-align: center;
            border: 1px solid rgba(255,255,255,.05);
        }

            .weather-day span {
                display: block;
                color: #9f9f9f;
                margin-bottom: 10px;
            }

            .weather-day i {
                color: #C8A45D;
                font-size: 22px;
                margin-bottom: 10px;
            }

            .weather-day strong {
                color: #fff;
                font-size: 18px;
            }

        .card-premium {
            background: rgba(15,15,15,.72);
            border: 1px solid rgba(200,164,93,.18);
            border-radius: 30px;
            padding: 30px;
            backdrop-filter: blur(14px);
            height: 100%;
            box-shadow: 0 10px 30px rgba(0,0,0,.45);
        }

        .card-header-lux {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 28px;
            font-weight: 700;
        }

        .icon-box {
            width: 55px;
            height: 55px;
            border-radius: 18px;
            background: rgba(200,164,93,.12);
            color: #C8A45D;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
        }

        .live-badge {
            padding: 8px 18px;
            border-radius: 30px;
            background: #1f7d36;
            font-size: 13px;
            font-weight: 700;
        }

        .currency-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 0;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        .currency-name {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 24px;
            font-weight: 600;
        }

        .currency-price {
            color: #38ff7a;
            font-size: 30px;
            font-weight: 800;
        }

        .weather-degree {
            font-size: 88px;
            font-weight: 900;
            text-align: center;
            margin-top: 20px;
        }

        .weather-city {
            text-align: center;
            font-size: 38px;
            color: #d8d8d8;
        }

        .weather-status {
            width: max-content;
            margin: auto;
            margin-top: 22px;
            padding: 10px 25px;
            border-radius: 40px;
            background: rgba(200,164,93,.12);
            border: 1px solid rgba(200,164,93,.16);
            color: #C8A45D;
        }

        .crypto-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .crypto-name {
            font-size: 28px;
            font-weight: 600;
        }

        .crypto-price {
            color: #38ff7a;
            font-size: 30px;
            font-weight: 800;
        }

        .fuel-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .fuel-name {
            font-size: 28px;
            font-weight: 600;
        }

        .fuel-price {
            color: #ff4c4c;
            font-size: 30px;
            font-weight: 800;
        }

        .converter-card {
            margin-top: 45px;
            background: rgba(15,15,15,.72);
            border: 1px solid rgba(200,164,93,.18);
            border-radius: 32px;
            padding: 40px;
            backdrop-filter: blur(14px);
        }

        .converter-title {
            font-size: 36px;
            font-weight: 800;
            margin-bottom: 30px;
        }

        .converter-input {
            width: 100%;
            height: 62px;
            border: none;
            outline: none;
            border-radius: 18px;
            background: #1a1a1a;
            color: white;
            padding: 0 22px;
            margin-bottom: 22px;
            font-size: 18px;
        }

        .convert-btn {
            width: 100%;
            height: 62px;
            border: none;
            border-radius: 18px;
            background: #C8A45D;
            color: black;
            font-weight: 800;
            font-size: 18px;
            transition: .3s;
        }

            .convert-btn:hover {
                transform: translateY(-2px);
            }

        .converter-result {
            margin-top: 35px;
            text-align: center;
            font-size: 42px;
            color: #C8A45D;
            font-weight: 900;
        }

        .bottom-features {
            margin-top: 45px;
        }

        .feature-box {
            background: rgba(15,15,15,.72);
            border: 1px solid rgba(200,164,93,.18);
            border-radius: 28px;
            padding: 30px;
            text-align: center;
            height: 100%;
        }

        .feature-icon {
            font-size: 50px;
            color: #C8A45D;
            margin-bottom: 20px;
        }

        .feature-title {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .feature-desc {
            color: #bdbdbd;
            line-height: 1.8;
        }

        .status-box {
            width: max-content;
            margin: auto;
            margin-top: 55px;
            margin-bottom: 60px;
            padding: 18px 40px;
            border-radius: 60px;
            background: rgba(15,15,15,.72);
            border: 1px solid rgba(200,164,93,.18);
            font-size: 22px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .green-dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #38ff7a;
        }

        .update-time {
            margin-top: 22px;
            color: #bcbcbc;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mini-converter {
            background: rgba(12,12,12,.88);
            border: 1px solid rgba(200,164,93,.25);
            border-radius: 24px;
            padding: 30px;
            backdrop-filter: blur(10px);
            box-shadow: 0 0 35px rgba(0,0,0,.55);
        }

            .mini-converter h3 {
                color: #fff;
                margin-bottom: 25px;
                font-weight: 700;
            }

            .mini-converter i {
                color: #C8A45D;
                margin-right: 8px;
            }

            .mini-converter input,
            .mini-converter select {
                width: 100%;
                background: #151515;
                border: none;
                border-radius: 14px;
                padding: 14px;
                color: #fff;
                margin-bottom: 15px;
            }

            .mini-converter button {
                width: 100%;
                background: #C8A45D;
                border: none;
                border-radius: 14px;
                padding: 14px;
                color: #000;
                font-weight: 700;
                transition: .3s;
            }

                .mini-converter button:hover {
                    transform: translateY(-3px);
                }

        #result {
            color: #C8A45D;
            font-size: 28px;
            font-weight: 800;
            text-align: center;
            margin-top: 25px;
        }

    </style>

</head>

<body>

    <div class="navbar-lux">

        <div class="logo">

            <i class="fa-solid fa-hotel"></i>

            Luxora

        </div>

        <div style="display:flex;gap:35px;font-weight:600;">

            <span>Keşfet</span>
            <span>Destinasyonlar</span>
            <span>Hakkımızda</span>

        </div>

    </div>

    <div class="hero">

        <div class="mini-title">
            LIVE TRAVEL SERVICES
        </div>

        <h1 class="main-title">

            SEYAHAT
            <span class="gold-text">
                ARAÇLARI
            </span>

        </h1>

        <div class="hero-desc">

            Canlı verilerle seyahatinizi planlayın,
            dünyayı takip edin.

        </div>

    </div>

    <div class="dashboard-wrapper">

        <div class="row g-4">

            <div class="col-md-3">

                <div class="card-premium">

                    <div class="card-header-lux">

                        <div class="card-title">

                            <div class="icon-box">
                                <i class="fa-solid fa-dollar-sign"></i>
                            </div>

                            Döviz

                        </div>

                        <div class="live-badge">
                            LIVE
                        </div>

                    </div>

                    <div class="currency-row">

                        <div class="currency-name">
                            🇺🇸 USD/TRY
                        </div>

                        <div class="currency-price">
                            45,43  ₺
                        </div>

                    </div>

                    <div class="currency-row">

                        <div class="currency-name">
                            🇪🇺 EUR/TRY
                        </div>

                        <div class="currency-price">
                            53,19 ₺
                        </div>

                    </div>

                    <div class="currency-row"
                         style="border:none;">

                        <div class="currency-name">
                            🇬🇧 GBP/TRY
                        </div>

                        <div class="currency-price">
                            50,44 ₺
                        </div>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card-premium">

                    <div class="card-header-lux">

                        <div class="card-title">

                            <div class="icon-box">
                                <i class="@ViewBag.WeatherIcon"></i>
                            </div>

                            Hava

                        </div>

                        <div class="live-badge">
                            LIVE
                        </div>

                    </div>

                    <div class="weather-degree">
                        @ViewBag.WeatherDegree
                    </div>

                    <div class="weather-city">
                        @ViewBag.City
                    </div>

                    <div class="weather-status">
                        @ViewBag.WeatherStatus
                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card-premium">

                    <div class="card-header-lux">

                        <div class="card-title">

                            <div class="icon-box">
                                <i class="fa-brands fa-bitcoin"></i>
                            </div>

                            Kripto

                        </div>

                        <div class="live-badge"
                             style="background:#8d6a00;">

                            MARKET

                        </div>

                    </div>

                    <div class="crypto-row">

                        <div class="crypto-name">
                            Bitcoin
                        </div>

                        <div class="crypto-price">
                            $104K
                        </div>

                    </div>

                    <div class="crypto-row">

                        <div class="crypto-name">
                            Ethereum
                        </div>

                        <div class="crypto-price">
                            $2.5K
                        </div>

                    </div>

                    <div class="crypto-row">

                        <div class="crypto-name">
                            Solana
                        </div>

                        <div class="crypto-price">
                            $176
                        </div>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card-premium">

                    <div class="card-header-lux">

                        <div class="card-title">

                            <div class="icon-box">
                                <i class="fa-solid fa-gas-pump"></i>
                            </div>

                            Akaryakıt

                        </div>


                    </div>

                    <div class="fuel-row">

                        <div class="fuel-name">
                            Benzin
                        </div>

                        <div class="fuel-price">
                            65,83 ₺
                        </div>

                    </div>

                    <div class="fuel-row">

                        <div class="fuel-name">
                            Dizel
                        </div>

                        <div class="fuel-price">
                            62,99 ₺
                        </div>

                    </div>

                    <div class="fuel-row">

                        <div class="fuel-name">
                            LPG
                        </div>

                        <div class="fuel-price"
                             style="color:#38ff7a;">

                            24 ₺

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="row mt-5">

            <div class="col-lg-8">

                <div class="features-row">

                    <div class="feature-box">
                        <i class="fa-solid fa-shield"></i>
                        <h4>Güvenilir Veri</h4>
                        <p>Tüm veriler güvenilir kaynaklardan anlık alınır.</p>
                    </div>

                    <div class="feature-box">
                        <i class="fa-solid fa-bolt"></i>
                        <h4>Anlık Güncelleme</h4>
                        <p>Canlı servislerle sürekli güncellenir.</p>
                    </div>

                    <div class="feature-box">
                        <i class="fa-solid fa-earth-europe"></i>
                        <h4>Dünya Geneli</h4>
                        <p>Tüm dünyadaki verileri takip edin.</p>
                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="tools-wrapper">

                    <!-- DÖVİZ -->

                    <div class="mini-converter">

                        <h3>
                            <i class="fa-solid fa-money-bill-transfer"></i>
                            Döviz Çevirici
                        </h3>

                        <input type="number"
                               id="amount"
                               placeholder="Miktar"
                               value="100" />

                        <select id="currency">

                            <option value="43.85">USD</option>

                            <option value="53.19">EUR</option>

                            <option value="50.44">GBP</option>

                        </select>

                        <button onclick="convertCurrency()">
                            Çevir
                        </button>

                        <div id="result">
                            100 USD = 4385₺
                        </div>

                    </div>

                    <!-- HAVA -->

                    <div class="lux-weather-card">

                        <div class="weather-top">

                            <div>

                                <span class="weather-mini-title">
                                    CANLI HAVA
                                </span>

                                <h2>İstanbul</h2>

                            </div>

                            <div class="weather-search">

                                <i class="fa-solid fa-magnifying-glass"></i>

                            </div>

                        </div>

                        <div class="weather-center">

                            <i class="fa-solid fa-cloud-sun weather-main-icon"></i>

                            <h1>14°</h1>

                            <p>Parçalı Bulutlu</p>

                        </div>

                        <div class="weather-days">

                            <div class="weather-day">

                                <span>Pzt</span>

                                <i class="fa-solid fa-cloud"></i>

                                <strong>16°</strong>

                            </div>

                            <div class="weather-day">

                                <span>Sal</span>

                                <i class="fa-solid fa-sun"></i>

                                <strong>20°</strong>

                            </div>

                            <div class="weather-day">

                                <span>Çar</span>

                                <i class="fa-solid fa-cloud-rain"></i>

                                <strong>12°</strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="bottom-features">

            <div class="row g-4">

                <div class="col-md-3">

                    <div class="feature-box">

                        <div class="feature-icon">
                            <i class="fa-solid fa-shield"></i>
                        </div>

                        <div class="feature-title">
                            Güvenilir Veri
                        </div>

                        <div class="feature-desc">

                            Tüm veriler güvenilir kaynaklardan
                            canlı olarak alınmaktadır.

                        </div>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="feature-box">

                        <div class="feature-icon">
                            <i class="fa-solid fa-bolt"></i>
                        </div>

                        <div class="feature-title">
                            Anlık Güncelleme
                        </div>

                        <div class="feature-desc">

                            Veriler otomatik olarak güncellenir.

                        </div>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="feature-box">

                        <div class="feature-icon">
                            <i class="fa-solid fa-earth-europe"></i>
                        </div>

                        <div class="feature-title">
                            Dünya Geneli
                        </div>

                        <div class="feature-desc">

                            Dünya çapında finans ve seyahat
                            verileri.

                        </div>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="feature-box">

                        <div class="feature-icon">
                            <i class="fa-solid fa-suitcase"></i>
                        </div>

                        <div class="feature-title">
                            Seyahat Planla
                        </div>

                        <div class="feature-desc">

                            Güncel verilerle daha iyi
                            seyahat deneyimi.

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="status-box">

            <div class="green-dot"></div>

            Tüm servisler aktif ve çalışıyor durumda

        </div>

    </div>

    <script>

        function convertCurrency() {

            let amount =
                document.getElementById("amount").value;

            let currency =
                document.getElementById("currency");

            let rate =
                currency.value;

            let currencyName =
                currency.options[currency.selectedIndex].text;

            let total =
                (amount * rate).toFixed(2);

            document.getElementById("result")
                .innerHTML =
                `${amount} ${currencyName} = ${total} ₺`;

        }

    </script>

</body>

</html>