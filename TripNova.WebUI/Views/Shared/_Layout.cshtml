<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Luxora</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>

        .room-hero {
            height: 480px;
            overflow: hidden;
            border-radius: 30px;
        }

            .room-hero img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .room-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .room-card {
            background: rgba(255,255,255,0.03);
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.04);
            transition: 0.4s;
        }

            .room-card:hover {
                transform: translateY(-6px);
            }

            .room-card img {
                width: 100%;
                height: 240px;
                object-fit: cover;
            }

        .room-content {
            padding: 24px;
        }

            .room-content p {
                color: #999;
                margin: 14px 0;
            }

        .room-tags {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

            .room-tags span {
                background: rgba(200,164,93,0.12);
                color: #C8A45D;
                padding: 8px 14px;
                border-radius: 30px;
                font-size: 13px;
            }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

            .gallery-grid img {
                width: 100%;
                height: 220px;
                object-fit: cover;
                border-radius: 22px;
                transition: 0.4s;
            }

                .gallery-grid img:hover {
                    transform: scale(1.03);
                }

        .info-box {
            background: rgba(255,255,255,0.03);
            border-radius: 20px;
            padding: 24px;
        }

            .info-box p {
                color: #aaa;
                margin-top: 10px;
            }

        .nearby-list {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .nearby-item {
            background: rgba(255,255,255,0.03);
            border-radius: 18px;
            padding: 20px;
            transition: 0.3s;
        }

            .nearby-item:hover {
                background: rgba(200,164,93,0.08);
            }

        .hero-image {
            height: 620px;
            border-radius: 34px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 20px 70px rgba(0,0,0,0.4);
        }

            .hero-image img {
                width: 100%;Exceptional
                height: 100%;
                object-fit: cover;
                transition: 0.7s;
                filter: brightness(0.85);
            }

            .hero-image:hover img {
                transform: scale(1.05);
            }

        .top-info-bar {
            display: flex;
            gap: 15px;
            margin-bottom: 35px;
            flex-wrap: wrap;
        }

        .info-pill {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(200,164,93,0.12);
            padding: 14px 22px;
            border-radius: 18px;
            backdrop-filter: blur(14px);
        }

        .detail-section {
            background: rgba(20,20,20,0.82);
            border-radius: 30px;
            padding: 34px;
            border: 1px solid rgba(255,255,255,0.04);
        }

        .reservation-card {
            background: rgba(18,18,18,0.92);
            border-radius: 34px;
            padding: 34px;
            border: 1px solid rgba(200,164,93,0.12);
            position: sticky;
            top: 120px;
            backdrop-filter: blur(18px);
        }

        .hotel-badge {
            background: rgba(200,164,93,0.15);
            color: #C8A45D;
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 14px;
        }

        .price {
            font-size: 62px;
            color: #C8A45D;
            font-weight: 700;
        }

        .old-price {
            color: #777;
            text-decoration: line-through;
        }

        .reserve-btn {
            width: 100%;
            height: 62px;
            border: none;
            border-radius: 18px;
            background: #C8A45D;
            color: black;
            font-weight: bold;
            transition: 0.4s;
        }

            .reserve-btn:hover {
                background: white;
                transform: translateY(-3px);
            }

        .review-card {
            background: rgba(255,255,255,0.03);
            border-radius: 22px;
            padding: 24px;
        }

        .review-top {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
        }

            .review-top span {
                color: #C8A45D;
                font-weight: 700;
            }


        .filter-panel {
            background: rgba(12,12,12,0.55);
            border-radius: 32px;
            padding: 32px;
            border: 1px solid rgba(255,255,255,0.06);
            backdrop-filter: blur(20px);
            box-shadow: 0 15px 45px rgba(0,0,0,0.35);
        }

        .filter-title {
            color: #C8A45D;
            font-size: 14px;
            margin-bottom: 10px;
            display: block;
        }

        .filter-input {
            background: #171717 !important;
            border: 1px solid rgba(255,255,255,0.08) !important;
            color: white !important;
            height: 55px;
            border-radius: 14px;
        }

        .search-btn {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: 16px;
            background: #C8A45D;
            color: black;
            font-weight: bold;
            margin-top: 20px;
        }

        .modern-hotel-card {
            background: rgba(15,15,15,0.78);
            border-radius: 32px;
            overflow: hidden;
            display: flex;
            margin-bottom: 35px;
            border: 1px solid rgba(200,164,93,0.10);
            transition: 0.45s ease;
            backdrop-filter: blur(18px);
            min-height: 320px;
            position: relative;
        }

            .modern-hotel-card:hover {
                transform: translateY(-10px) scale(1.01);
                box-shadow: 0 20px 60px rgba(0,0,0,0.45), 0 0 35px rgba(200,164,93,0.16);
            }

            .modern-hotel-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0 30px rgba(200,164,93,0.12);
            }

        .modern-image {
            width: 420px;
            min-height: 320px;
            position: relative;
            overflow: hidden;
        }

            .modern-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .modern-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: 0.6s;
            }

        .modern-hotel-card:hover img {
            transform: scale(1.08);
        }

        .modern-content {
            flex: 1;
            display: flex;
            justify-content: space-between;
            padding: 38px;
            gap: 30px;
        }

        .modern-title {
            font-size: 42px;
            line-height: 1.05;
            margin-bottom: 16px;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .modern-location {
            color: #b5b5b5;
            margin-bottom: 15px;
        }

        .modern-stars {
            color: #C8A45D;
            margin-bottom: 20px;
        }

        .modern-features {
            display: flex;
            gap: 15px;
        }

            .modern-features span {
                background: rgba(255,255,255,0.04);
                border: 1px solid rgba(255,255,255,0.05);
                padding: 14px 18px;
                border-radius: 18px;
                transition: 0.3s;
            }

                .modern-features span:hover {
                    background: #C8A45D;
                    color: black;
                }

        .modern-price-area {
            text-align: right;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .review-box {
            background: #C8A45D;
            color: black;
            padding: 10px 16px;
            border-radius: 12px;
            font-weight: bold;
            margin-bottom: 20px;
            display: inline-block;
        }

        .modern-price-area h1 {
            color: #C8A45D;
            font-size: 42px;
            font-weight: bold;
        }

        .modern-detail-btn {
            background: #C8A45D;
            color: black;
            text-decoration: none;
            padding: 14px 30px;
            border-radius: 14px;
            font-weight: bold;
            margin-top: 15px;
            display: inline-block;
        }

            .modern-detail-btn:hover {
                background: white;
                color: black;
                transform: translateY(-2px);
            }

        .premium-hotel-card {
            background: rgba(17,17,17,0.92);
            border-radius: 28px;
            overflow: hidden;
            display: flex;
            min-height: 320px;
            border: 1px solid rgba(200,164,93,0.15);
            margin-bottom: 30px;
            transition: 0.4s;
            backdrop-filter: blur(10px);
        }

            .premium-hotel-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 0 35px rgba(200,164,93,0.15);
            }

        .hotel-image-area {
            width: 38%;
            position: relative;
        }

            .hotel-image-area img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .hotel-badge {
            position: absolute;
            top: 20px;
            left: 20px;
            background: #1E1E1E;
            color: #C8A45D;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
        }

        .hotel-content-area {
            width: 62%;
            display: flex;
            justify-content: space-between;
            padding: 35px;
        }

        .hotel-title {
            font-size: 38px;
            margin-top: 10px;
            margin-bottom: 15px;
        }

        .hotel-location {
            color: #C8A45D;
            letter-spacing: 1px;
        }

        .hotel-stars {
            font-size: 18px;
            color: #C8A45D;
            margin-bottom: 20px;
        }

        .review-score {
            background: #C8A45D;
            color: black;
            padding: 5px 10px;
            border-radius: 10px;
            margin-left: 10px;
            font-weight: bold;
        }

        .hotel-features {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 25px;
        }

            .hotel-features span {
                background: #202020;
                padding: 10px 16px;
                border-radius: 20px;
                color: #d1d1d1;
            }

        .hotel-description {
            color: #9b9b9b;
            max-width: 650px;
            line-height: 30px;
        }

        .hotel-right {
            text-align: right;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .hotel-price {
            color: #C8A45D;
            font-size: 50px;
            font-weight: bold;
        }

        .per-night {
            color: #888;
            margin-bottom: 30px;
        }

        .hotel-detail-btn {
            background: #C8A45D;
            color: black;
            padding: 15px 35px;
            border-radius: 14px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

            .hotel-detail-btn:hover {
                background: white;
                color: black;
            }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: -1;
        }


        body {
            color: white;
            font-family: Arial;
        }

        .navbar {
            background-color: rgba(0,0,0,0.6);
            padding: 20px;
            backdrop-filter: blur(10px);
        }

        .logo {
            color: #C8A45D;
            font-size: 30px;
            font-weight: bold;
            text-decoration: none;
        }

        .menu-link {
            color: white;
            text-decoration: none;
            transition: 0.3s;
            font-size: 17px;
        }

            .menu-link:hover {
                color: #C8A45D;
            }

        .login-btn {
            background: #C8A45D;
            padding: 10px 20px;
            border-radius: 10px;
            color: black;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

            .login-btn:hover {
                background: white;
                color: black;
            }

        .dashboard-card {
            background: rgba(23,23,23,0.92);
            border-radius: 25px;
            padding: 30px;
            border: 1px solid rgba(200,164,93,0.12);
            backdrop-filter: blur(12px);
            min-height: 260px;
            transition: 0.4s;
            box-shadow: 0 0 25px rgba(0,0,0,0.35);
        }

            .dashboard-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 0 30px rgba(200,164,93,0.15);
            }

        .old-price {
            color: #7c7c7c;
            text-decoration: line-through;
            margin-bottom: 5px;
            font-size: 18px;
        }

        .discount-badge {
            background: #163a20;
            color: #7dff9d;
            padding: 8px 14px;
            border-radius: 12px;
            font-size: 13px;
            margin-bottom: 20px;
            display: inline-block;
            font-weight: 600;
        }

        <div class="container mb-5" >

        <div class="text-center mb-5" >

        <p style="
        color:#C8A45D;
        letter-spacing:3px;">

        LIVE TRAVEL SERVICES

        </p >

        <h1 class="fw-bold" >
        Seyahat Araçları
        </h1 >

        </div >

        <div class="row" >

        <div class="col-md-3 mb-4" >

        <div class="dashboard-card" >

        <h5 class="mb-4" >
        💵 Döviz Kurları
        </h5 >

        <div class="d-flex justify-content-between mb-3" >
        <span > USD</span >
        <strong > 38.72 ₺</strong >
        </div >

        <div class="d-flex justify-content-between mb-3" >
        <span > EUR</span >
        <strong > 42.11 ₺</strong >
        </div >

        <div class="d-flex justify-content-between" >
        <span > GBP</span >
        <strong > 49.88 ₺</strong >
        </div >

        </div >

        </div >

        <div class="col-md-3 mb-4" >

        <div class="dashboard-card text-center" >

        <h5 class="mb-4" >
        ☁️ Hava Durumu
        </h5 >

        <h1 style="
        color:#C8A45D;
        font-size:55px;">

        13°C

        </h1 >

        <p class="text-secondary" >
        Paris / Cloudy
        </p >

        </div >

        </div >

        <div class="col-md-3 mb-4" >

        <div class="dashboard-card" >

        <h5 class="mb-4" >
        ₿ Kripto
        </h5 >

        <div class="d-flex justify-content-between mb-3" >
        <span > Bitcoin</span >
        <strong > $104K</strong >
        </div >

        <div class="d-flex justify-content-between mb-3" >
        <span > Ethereum</span >
        <strong > $2.5K</strong >
        </div >

        <div class="d-flex justify-content-between" >
        <span > Solana</span >
        <strong > $176</strong >
        </div >

        </div >

        </div >

        <div class="col-md-3 mb-4" >

        <div class="dashboard-card" >

        <h5 class="mb-4" >
        ⛽ Akaryakıt
        </h5 >

        <div class="d-flex justify-content-between mb-3" >
        <span > Benzin</span >
        <strong > 46.82 ₺</strong >
        </div >

        <div class="d-flex justify-content-between mb-3" >
        <span > Motorin</span >
        <strong > 44.15 ₺</strong >
        </div >

        <div class="d-flex justify-content-between" >
        <span > LPG</span >
        <strong > 24.40 ₺</strong >
        </div >

        </div >

        </div >

        </div >

        </div >

    </style>

</head>

<body style="
background-image:url('/images/banner.jpeg');
background-size:cover;
background-position:center;
background-attachment:fixed;">

    <div style="
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.75);
    z-index:-1;">
    </div>

    <div class="navbar">

        <div class="container d-flex justify-content-between align-items-center">

            <a href="#" class="logo">
                <i class="fa-solid fa-hotel"></i> Luxora
            </a>

            <div class="d-flex gap-4 align-items-center">

                <a href="#" class="menu-link">Keşfet</a>

                <a href="#" class="menu-link">Destinasyonlar</a>

                <a href="#" class="menu-link">Hakkımızda</a>

                <a href="#" class="login-btn">
                    Giriş Yap
                </a>

            </div>

        </div>

    </div>

    <div class="container">
        @RenderBody()
    </div>

</body>
</html>